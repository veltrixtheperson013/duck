DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Discord dashboard login. Add the redirect URI in Discord's Developer Portal.
DISCORD_CLIENT_SECRET=your_application_client_secret_here
DISCORD_OAUTH_REDIRECT_URI=https://duck.wispbyte.app/auth/discord/callback
DUCK_SESSION_SECURE=true
# Optional fallback for team-owned Discord applications. Comma-separated Discord user IDs.
DUCK_OWNER_USER_IDS=

# Stripe Checkout for Duck Plus and one-time development support. All values stay server-side.
DUCK_PUBLIC_URL=https://duck.wispbyte.app
# Master switch for new Duck Plus activations and checkout. Keep false until launch.
DUCK_PLUS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_YEARLY_PRICE_ID=

# Optional fallback support-payment URL when Stripe is not configured.
# Duck replaces {amount} with one of: 1, 5, 10, 20, 50, or 100.
DUCK_DONATION_CHECKOUT_URL=

# Hosted OpenRouter AI. Requires an OpenRouter account/API key.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=tencent/hy3:free
OPENROUTER_SITE_URL=https://duck.local
OPENROUTER_APP_NAME=Duck Discord Bot

# How much server-wide context to send to AI planners/chat.
AI_CONTEXT_CHANNELS=all
AI_CONTEXT_ALL_CHANNEL_LIMIT=25
AI_CONTEXT_MESSAGES_PER_CHANNEL=10
AI_CONTEXT_FOCUSED_MESSAGES=50
AI_CONTEXT_BACKGROUND_MESSAGES=5
AI_CONTEXT_MAX_MESSAGES=500
AI_CONTEXT_MAX_CHARS=32000
AI_CONTEXT_MESSAGE_CHARS=160
AI_CONTEXT_FETCH_CONCURRENCY=6
AI_CONTEXT_ATTACHMENT_LIMIT=6
AI_CONTEXT_MEMBER_LIMIT=500
AI_CONTEXT_CHANNEL_LIMIT=250
AI_CONTEXT_ROLE_LIMIT=250
AI_CONTEXT_CACHE_TTL_MS=15000
AI_CHAT_MAX_TOKENS=700
AI_CHAT_MAX_ATTEMPTS=3
AI_REQUEST_TIMEOUT_MS=30000
AI_HTTP_MAX_ATTEMPTS=2
AI_REASONING_EFFORT=low
AI_MAX_CONCURRENT_GLOBAL=4
AI_MAX_CONCURRENT_PER_GUILD=1
AI_MAX_QUEUE_PER_GUILD=20
AI_MAX_QUEUE_GLOBAL=200
AI_EXCLUDE_REASONING=true
AI_VISION_ENABLED=true
AI_VISION_MODE=auto
AI_VISION_MODELS=
AI_VISION_MAX_IMAGES=4
AI_VISION_BATCH_SIZE=2
AI_VISION_MAX_ATTACHMENT_BYTES=8388608
AI_VISION_DETAIL=low
DUCK_MESSAGE_CACHE_TTL_MS=60000
DUCK_MESSAGE_CACHE_LIMIT=100
DUCK_MESSAGE_CACHE_MAX_CHANNELS=50
