DUCK_RESOURCE_CACHE_MAX_ITEMS=200
DUCK_JSON_WRITE_DEBOUNCE_MS=500
DUCK_CACHE_SWEEP_MS=120000
DUCK_CACHE_REFRESH_MS=180000
DUCK_CACHE_REFRESH_MAX_CHANNELS=10
DUCK_RESOURCE_CACHE_REFRESH_MAX_ITEMS=25
DUCK_CONTEXT_CACHE_MAX_ITEMS=200
DUCK_CACHE_REFRESH_CONCURRENCY=2
PENDING_ACTION_TTL_MS=1800000
DUCK_QUEUE_MESSAGE=Duck is thinking...
DUCK_STATUS_TEXT=the pond's criminal masterminds 🦆
DUCK_STATUS_TYPE=watching
DUCK_STATUS_STATE=online
DUCK_COMMAND_SCOPE=guild
DUCK_COMMAND_SYNC_CONCURRENCY=2
DUCK_DEBUG=true
DUCK_DEBUG_AI_BODY=false

# Optional features ported from the older discord.py bot.
DUCK_LEGACY_PREFIXES=!,!!
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
DEEPGRAM_API_KEY=
DUCK_VOICE_DAVE=true
DUCK_TTS_CHARS_PER_MINUTE=3000
DUCK_TTS_USER_CHARS_PER_MINUTE=1200
